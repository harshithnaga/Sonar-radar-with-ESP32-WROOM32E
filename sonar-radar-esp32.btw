@CODE lang=arduino lines=140
| #include <TFT_eSPI.h>
| #include <ESP32Servo.h>
| 
| // ---------- Pins ----------
| #define TRIG_PIN   12
| #define ECHO_PIN   14
| #define SERVO_PIN  13
| 
| // ---------- Radar parameters ----------
| const int   SWEEP_MIN_DEG   = 15;
| const int   SWEEP_MAX_DEG   = 165;
| const int   SWEEP_STEP_DEG  = 2;      // angular resolution
| const int   STEP_DELAY_MS   = 40;     // let the servo settle before pinging
| const float MAX_RANGE_CM    = 200.0;  // HC-SR04 reliable range ~2-400cm
| 
| // ---------- Display geometry ----------
| const int SCREEN_W   = 320;
| const int SCREEN_H   = 240;
| const int ORIGIN_X   = SCREEN_W / 2;
| const int ORIGIN_Y   = SCREEN_H - 10;
| const int RADIUS_PX  = 200;           // on-screen radius for MAX_RANGE_CM
| 
| TFT_eSPI tft = TFT_eSPI();
| Servo    sonarServo;
| 
| int   currentAngle   = SWEEP_MIN_DEG;
| int   sweepDirection = 1;
| 
| struct Blip {
|   int   angle;
|   float distanceCm;
|   bool  active;
| };
| const int MAX_BLIPS = 90;
| Blip blips[MAX_BLIPS];
| 
| void setup() {
|   Serial.begin(115200);
| 
|   pinMode(TRIG_PIN, OUTPUT);
|   pinMode(ECHO_PIN, INPUT);
| 
|   sonarServo.attach(SERVO_PIN, 500, 2400);
|   sonarServo.write(currentAngle);
| 
|   tft.init();
|   tft.setRotation(1);            // landscape; adjust 0-3 to match your wiring
|   tft.fillScreen(TFT_BLACK);
| 
|   for (int i = 0; i < MAX_BLIPS; i++) blips[i].active = false;
| 
|   drawRadarGrid();
| }
| 
| void loop() {
|   sonarServo.write(currentAngle);
|   delay(STEP_DELAY_MS);
| 
|   float distanceCm = measureDistanceCm();
|   recordBlip(currentAngle, distanceCm);
| 
|   drawRadarGrid();
|   drawSweepLine(currentAngle);
|   drawBlips();
| 
|   Serial.printf("angle=%3d  distance=%.1f cm\n", currentAngle, distanceCm);
| 
|   currentAngle += sweepDirection * SWEEP_STEP_DEG;
|   if (currentAngle >= SWEEP_MAX_DEG) {
|     currentAngle = SWEEP_MAX_DEG;
|     sweepDirection = -1;
|   } else if (currentAngle <= SWEEP_MIN_DEG) {
|     currentAngle = SWEEP_MIN_DEG;
|     sweepDirection = 1;
|   }
| }
| 
| // ---------- Sensing ----------
| float measureDistanceCm() {
|   digitalWrite(TRIG_PIN, LOW);
|   delayMicroseconds(2);
|   digitalWrite(TRIG_PIN, HIGH);
|   delayMicroseconds(10);
|   digitalWrite(TRIG_PIN, LOW);
| 
|   long durationUs = pulseIn(ECHO_PIN, HIGH, 30000UL);  // 30ms timeout
|   if (durationUs == 0) return -1;                      // no echo received
| 
|   float distanceCm = (durationUs * 0.0343f) / 2.0f;
|   if (distanceCm < 2 || distanceCm > 400) return -1;   // outside sensor spec
|   return distanceCm;
| }
| 
| void recordBlip(int angle, float distanceCm) {
|   int slot = (angle - SWEEP_MIN_DEG) / SWEEP_STEP_DEG;
|   if (slot < 0 || slot >= MAX_BLIPS) return;
| 
|   if (distanceCm > 0 && distanceCm <= MAX_RANGE_CM) {
|     blips[slot].angle      = angle;
|     blips[slot].distanceCm = distanceCm;
|     blips[slot].active     = true;
|   } else {
|     blips[slot].active = false;
|   }
| }
| 
| // ---------- Drawing ----------
| void drawRadarGrid() {
|   tft.fillScreen(TFT_BLACK);
| 
|   for (int r = RADIUS_PX / 4; r <= RADIUS_PX; r += RADIUS_PX / 4) {
|     tft.drawCircle(ORIGIN_X, ORIGIN_Y, r, TFT_DARKGREEN);
|   }
| 
|   for (int a = 0; a <= 180; a += 45) {
|     int x = ORIGIN_X + RADIUS_PX * cos(radians(180 - a));
|     int y = ORIGIN_Y - RADIUS_PX * sin(radians(180 - a));
|     tft.drawLine(ORIGIN_X, ORIGIN_Y, x, y, TFT_DARKGREEN);
|   }
| 
|   tft.drawLine(0, ORIGIN_Y, SCREEN_W, ORIGIN_Y, TFT_DARKGREEN);
| }
| 
| void drawSweepLine(int angle) {
|   int x = ORIGIN_X + RADIUS_PX * cos(radians(180 - angle));
|   int y = ORIGIN_Y - RADIUS_PX * sin(radians(180 - angle));
|   tft.drawLine(ORIGIN_X, ORIGIN_Y, x, y, TFT_GREEN);
| }
| 
| void drawBlips() {
|   for (int i = 0; i < MAX_BLIPS; i++) {
|     if (!blips[i].active) continue;
| 
|     float rPx = map(blips[i].distanceCm * 10, 0, MAX_RANGE_CM * 10, 0, RADIUS_PX);
|     int x = ORIGIN_X + rPx * cos(radians(180 - blips[i].angle));
|     int y = ORIGIN_Y - rPx * sin(radians(180 - blips[i].angle));
| 
|     tft.fillCircle(x, y, 3, TFT_YELLOW);
|   }
| }
@END parts=9 wires=21 crc32=59C1FFF8
